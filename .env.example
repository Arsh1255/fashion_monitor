# NVIDIA NIM Visual AI Credentials & Configuration
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Multi-Category & Pagination Scraping Configuration
# Format: Category1,URL1;Category2,URL2;Category3,URL3
TARGET_URLS=Men,https://www2.hm.com/en_in/men/new-arrivals/view-all.html;Women,https://www2.hm.com/en_in/ladies/new-arrivals/view-all.html;Kids,https://www2.hm.com/en_in/kids/new-arrivals/view-all.html
HEADLESS=false
MAX_PAGES_PER_CATEGORY=1
MAX_ITEMS_PER_CATEGORY=4

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_EMAIL=recipient@example.com

# System File & Directory Paths
STORAGE_PATH=data/seen_products.json
OUTPUT_PATH=output/report.pdf
SCREENSHOT_DIR=screenshots
LOG_FILE=logs/app.log
