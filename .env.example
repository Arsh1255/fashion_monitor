# NVIDIA NIM Visual AI Credentials & Configuration
NVIDIA_API_KEY=nvapi-your-api-key-here
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Multi-Category & Pagination Scraping Configuration
HEADLESS=true
MAX_PAGES_PER_CATEGORY=2
MAX_ITEMS_PER_CATEGORY=2
MAX_CANDIDATE_POOL_SIZE=12

# SMTP Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=recipient-email@gmail.com

# System File & Directory Paths
STORAGE_PATH=data/seen_products.json
OUTPUT_PATH=output/report.pdf
SCREENSHOT_DIR=screenshots
LOG_FILE=logs/app.log
